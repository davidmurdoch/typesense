+// Normalize the GNU and POSIX strerror_r APIs, including libc's unknown-error text.
+static const char* SystemErrorDescription(int error_code) {
+#if !defined(__GLIBC__) || !defined(_GNU_SOURCE)
+    const int rc = strerror_r(error_code, tls_error_buf, ERROR_BUFSIZE);
+    if (rc != 0 && rc != ERANGE) {
+        return NULL;
+    }
+    char unknown_error[ERROR_BUFSIZE];
+    const int saved_errno = errno;
+    const int unknown_rc = strerror_r(-1, unknown_error, sizeof(unknown_error));
+    errno = saved_errno;
+    if (error_code != 0 && unknown_rc == 0 &&
+        strcmp(tls_error_buf, unknown_error) == 0) {
+        return NULL;
+    }
+    return tls_error_buf;
+#else
+    const char* desc = strerror_r(error_code, tls_error_buf, ERROR_BUFSIZE);
+    return desc && strncmp(desc, "Unknown error", 13) != 0 ? desc : NULL;
+#endif
+}
