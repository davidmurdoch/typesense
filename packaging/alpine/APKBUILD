# Maintainer: David Murdoch <187813+davidmurdoch@users.noreply.github.com>
# abuild supplies build paths and consumes the package metadata.
# shellcheck disable=SC2034,SC2154
# Packages the binary built and tested by the native Alpine workflow.
pkgname=typesense
pkgver=30.2
pkgrel=${TYPESENSE_PKGREL:-0}
pkgdesc="Fast, typo-tolerant search engine"
url="https://typesense.org"
arch="x86_64"
license="GPL-3.0-only"
depends="ca-certificates libgcc libunwind musl-fts musl-obstack"
subpackages="$pkgname-openrc"
install="$pkgname.pre-install"
source="typesense.initd typesense.confd typesense-server.ini LICENSE.txt"
options="!check !strip"
builddir="$srcdir"

build() {
    :
}

package() {
    install -Dm755 "$TYPESENSE_BINARY" "$pkgdir/usr/bin/typesense-server"
    install -Dm755 "$srcdir/typesense.initd" "$pkgdir/etc/init.d/typesense"
    install -Dm644 "$srcdir/typesense.confd" "$pkgdir/etc/conf.d/typesense"
    install -Dm640 "$srcdir/typesense-server.ini" "$pkgdir/etc/typesense/typesense-server.ini"
    chgrp typesense "$pkgdir/etc/typesense/typesense-server.ini"
    install -Dm644 "$srcdir/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}

pkgusers="typesense"
pkggroups="typesense"

sha512sums="
